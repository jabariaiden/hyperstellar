#version 430 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ----------------------------------------------------------------------------
// DATA STRUCTURES (same as math.comp)
// ----------------------------------------------------------------------------
struct Object {
    vec2 position;
    vec2 velocity;
    float mass;
    float charge;
    int visualSkinType;
    int collisionShapeType;
    vec4 visualData;
    vec4 collisionData;
    vec4 color;
    int equationID;
    int scriptID;
    int _pad[2];
};

// ----------------------------------------------------------------------------
// BUFFERS (binding 0 = object SSBO, 2 = tokens, 3 = constants)
// ----------------------------------------------------------------------------
layout(std430, binding = 0) readonly buffer ObjectsIn { Object objectsIn[]; };
layout(std430, binding = 2) readonly buffer PaintTokens { int allTokens[]; };
layout(std430, binding = 3) readonly buffer PaintConstants { float allConstants[]; };

// ----------------------------------------------------------------------------
// TEXTURES (double‑buffered)
// ----------------------------------------------------------------------------
uniform sampler2D uPrevFrame;
layout(rgba8, binding = 0) writeonly uniform image2D uPaintTarget;

// ----------------------------------------------------------------------------
// UNIFORMS
// ----------------------------------------------------------------------------
uniform int uNumObjects;
uniform float uTime;
uniform float uCameraX;
uniform float uCameraY;
uniform float uHalfWidth;
uniform float uHalfHeight;
uniform int uScreenWidth;
uniform int uScreenHeight;
uniform int uTexWidth;
uniform int uTexHeight;

uniform int uTokenOffset_r;   uniform int uTokenCount_r;   uniform int uConstOffset_r;
uniform int uTokenOffset_g;   uniform int uTokenCount_g;   uniform int uConstOffset_g;
uniform int uTokenOffset_b;   uniform int uTokenCount_b;   uniform int uConstOffset_b;
uniform int uTokenOffset_a;   uniform int uTokenCount_a;   uniform int uConstOffset_a;

