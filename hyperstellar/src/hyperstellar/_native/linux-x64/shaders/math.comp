#version 430 core
// Welcome to the EVILNATOR shader! Or formarly known as:
// ============================================================================
// HYPERSTELLAR PHYSICS ENGINE – COMPUTE SHADER
// ============================================================================
// This shader implements a full 2D physics engine with a DSL for equations.
//
// FEATURES:
// • Complex numbers (i, real, imag, conj, arg)
// • Derivatives D(expr, var, order) for any variable (x, y, vx, vy, theta, omega, mass, charge)
// • Tensor literals [a,b,c] (vectors of length 2–4)
// • dot(v1, v2), cross(v1, v2), norm(v)
// • select(condition, a, b) – condition can use <, <=, >, >=, ==, !=
// • sum_neighbors(weight, body) – loops over all other objects
// • Smooth Perlin noise(x,y), rand()
// • Object references: p[id].x, p[id].y, p[id].vx, ..., p[id].theta, p[id].radius, etc.
// • Collisions: circle, AABB, convex polygon (SAT)
// • Constraints: distance, boundary, angle
// • Warm starting for contacts
// • Symplectic Euler integration
//
// Author: Aiden Jabari
// Wrote this shader so that no one has to write a thousand case stetements for a DSL
// You can thank me later. Or not. I don't care. I just want to finish this project and move on to the next one.
// ============================================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ----------------------------------------------------------------------------
// DATA STRUCTURES (should be same as CPU side)
// ----------------------------------------------------------------------------
struct Object {
    vec2 position;
    vec2 velocity;
    float mass;
    float charge;
    int visualSkinType;
    int collisionShapeType;
    vec4 visualData;          // x = radius/width, y = height, z = theta, w = omega
    vec4 collisionData;       // x = previous ax, y = previous ay
    vec4 color;
    int equationID;
    int _pad1;
    int _padEnd[2];
};

struct EquationMapping {
    int tokenOffset_ax;      int tokenCount_ax;      int constantOffset_ax;      int _pad1;
    int tokenOffset_ay;      int tokenCount_ay;      int constantOffset_ay;      int _pad2;
    int tokenOffset_angular; int tokenCount_angular; int constantOffset_angular; int _pad3;
    int tokenOffset_r;       int tokenCount_r;       int constantOffset_r;       int _pad4;
    int tokenOffset_g;       int tokenCount_g;       int constantOffset_g;       int _pad5;
    int tokenOffset_b;       int tokenCount_b;       int constantOffset_b;       int _pad6;
    int tokenOffset_a;       int tokenCount_a;       int constantOffset_a;       int _pad7;
};

struct Constraint {
    int type;                // 0 = distance, 1 = boundary, 2 = angle
    int targetObjectID;
    float param1;
    float param2;
    float param3;
    float param4;
    int _pad1;
    int _pad2;
};

struct ObjectConstraints {
    int objectID;
    int numConstraints;
    int constraintOffset;
    int _pad;
};

struct CollisionProperties {
    int enabled;
    int shapeType;           // 0 = none, 1 = circle, 2 = AABB, 3 = polygon
    float restitution;
    float friction;
    float mass_factor;
    int _pad1;
    int _pad2;
    int _pad3;
};

struct CollisionInfo {
    bool hasCollision;
    vec2 normal;
    float penetration;
    int otherObjectID;
    vec2 contactPoint;
};

struct ContactPoint {
    vec2 normal;
    vec2 position;
    float penetration;
    float accumulatedNormalImpulse;
    float accumulatedTangentImpulse;
    int frameCount;
};

// ----------------------------------------------------------------------------
// BUFFERS AND UNIFORMS
// ----------------------------------------------------------------------------
layout(std430, binding = 0) readonly buffer ObjectsIn { Object objectsIn[]; };
layout(std430, binding = 1) writeonly buffer ObjectsOut { Object objectsOut[]; };
layout(std430, binding = 2) readonly buffer AllEquationTokens { int allTokens[]; };
layout(std430, binding = 3) readonly buffer AllEquationConstants { float allConstants[]; };
layout(std430, binding = 4) readonly buffer EquationMappings { EquationMapping mappings[256]; };
layout(std430, binding = 5) readonly buffer Constraints { Constraint constraints[]; };
layout(std430, binding = 6) readonly buffer ObjectConstraintMappings { ObjectConstraints objectConstraints[]; };
layout(std430, binding = 7) readonly buffer CollisionProps { CollisionProperties collisionProps[]; };
layout(std430, binding = 8) buffer ContactBuffer { ContactPoint contacts[]; };

uniform float uDt;                   // time step
uniform float uTime;                 // global time
uniform float k;                     // spring constant
uniform float b;                     // damping coefficient
uniform float g;                     // gravity strength
uniform vec2  uGravityDir;           // gravity direction
uniform float uRestitution;          // default restitution
uniform float uCoupling;             // coupling constant
uniform vec2  uExternalForce;        // constant external force
uniform float uDriveFreq;            // driving frequency
uniform float uDriveAmp;             // driving amplitude
uniform int   uEquationMode;         // 0 = use equations, else default
uniform int   uNumObjects;           // number of objects
uniform int   uEnableWarmStart;      // 1 = enable warm starting
uniform int   uMaxContactIterations; // maximum contact iterations
uniform float uDerivativeEpsilon;    // step size for numerical derivatives

